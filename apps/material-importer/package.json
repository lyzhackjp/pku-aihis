{
  "name": "pku-aihis-material-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node scripts/prepare-vendor.mjs && vite --host 127.0.0.1 --port 5174",
