    "pdfjs-dist": "5.6.205",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
